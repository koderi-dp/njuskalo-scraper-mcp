# From Cloudflare Zero Trust > Networks > Tunnels > Create tunnel (cloudflared).
# Set the tunnel's public hostname service to http://njuskalo-mcp:8000
TUNNEL_TOKEN=

# Long random string, e.g. from: openssl rand -hex 24
# Your MCP URL becomes https://<your-hostname>/<MCP_SECRET_PATH>/mcp
MCP_SECRET_PATH=

# Optional: also require "Authorization: Bearer <token>" (Claude Code can send it, claude.ai can't)
MCP_AUTH_TOKEN=

# Optional: Croatian residential proxy
NJUSKALO_PROXY=
